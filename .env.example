# Público: identificador de Meta Pixel (no es un secreto).
NEXT_PUBLIC_META_PIXEL_ID=

# Servidor: token de Mercado Pago. No exponer al navegador.
MP_ACCESS_TOKEN=

# Reservadas para Conversions API (no configurar en esta etapa).
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# META_GRAPH_API_VERSION=
# META_TEST_EVENT_CODE=
MP_WEBHOOK_SECRET=

# Lecturas: cola de preguntas pagadas. Dejar sin valores hasta verificar el dominio en Resend.
# El envío real solo ocurre si LECTURAS_EMAIL_ENABLED es exactamente true.
# LECTURAS_EMAIL_ENABLED=
# RESEND_API_KEY=
# Sin dominio propio, Resend solo entrega pruebas al email de la cuenta,
# usando el remitente onboarding@resend.dev. La cuenta debe ser el Gmail de DITER.
# RESEND_FROM_EMAIL=Grupo Diter <onboarding@resend.dev>
# RESEND_FROM_EMAIL=Grupo Diter <notificaciones@dominio-verificado>
# LECTURAS_NOTIFY_EMAIL=diferentedeterminado@gmail.com
# LECTURAS_VALIDATION_KEY=
# CRON_SECRET queda solo en el servidor. Si existe en el proyecto, Vercel Cron envía
# Authorization: Bearer con ese valor al invocar la ruta. No lo expongas al navegador
# ni lo reutilices como LECTURAS_VALIDATION_KEY.
# Hobby admite una ejecución por día. vercel.json declara
# GET /api/lecturas/notifications/cron con schedule "0 12 * * *" (12:00 UTC).
# CRON_SECRET=