# Configuración separada para pruebas de lecturas.
# No reemplaza .env.local ni la DATABASE_URL de producción.
# No usar el endpoint ep-blue-queen-b6q4ktjv.
# No usar la rama backup-pre-migracion-002-diter (br-lucky-scene-b6vp8qp2).
# La rama de pruebas se crea desde production solo después de una autorización explícita.
#
# Copiar este archivo a config/lecturas-test.env y completar los valores allí.
# config/lecturas-test.env queda ignorado por Git.

LECTURAS_TEST_DATABASE_URL=
LECTURAS_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LECTURAS_NOTIFY_EMAIL=
LECTURAS_VALIDATION_KEY=
CRON_SECRET=
